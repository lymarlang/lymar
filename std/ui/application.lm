import std.ui.types as ui_types;
// NOTE: std.app is NOT imported here to avoid the circular import cycle:
//   std.app -> std.ui.types -> (via std.ui.index) -> std.ui.application -> std.app
// Instead, Application.run() lazily imports std.app at call time.

frame Application {
    pub var name: str;
    pub var root_widget: ui_types.Widget;

    pub init(n: str = "LimitApp") {
        self.name = n;
        self.root_widget = ui_types.empty();
    }

    pub fn set_root(widget: ui_types.Widget): nil {
        self.root_widget = widget;
    }

    pub fn run(): nil {
        // Lazy import to break the circular dependency
        import std.app as _app;
        var cfg = _app.default_window_config();
        cfg.title = self.name;
        _app.init(cfg);
        _app.set_ui(self.root_widget);
        _app.run();
        _app.shutdown();
    }
}
