fn test_gui_layout_column() {
    print("=== TEST 15: GUI Layout Column ===");
    
    var gui = game.GUI();
    
    gui.begin(800.0, 600.0, false);
    gui.begin_column(100.0);
    
    gui.button("Button 1", 80.0, 30.0);
    gui.button("Button 2", 80.0, 30.0);
    gui.button("Button 3", 80.0, 30.0);
    
    gui.end_column();
    gui.end();
    
    print("  ✓ GUI layout column works");
}

