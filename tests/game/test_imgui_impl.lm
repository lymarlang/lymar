// tests/game/test_imgui_impl.lm
// Complete test suite for std.game Immediate-Mode GUI library
// This is a FULL IMPLEMENTATION TEST, not a stub

import std.game as game;
import std.gg as gg;

// ─────────────────────────────────────────────────────────────────────────────
// TEST 1: Basic Type Construction
// ─────────────────────────────────────────────────────────────────────────────

fn test_vec2_construction() {
    print("=== TEST 1: Vec2 Construction ===");
    
    var v1 = game.Vec2(10.0, 20.0);
    assert(v1.x == 10.0, "Vec2.x mismatch");
    assert(v1.y == 20.0, "Vec2.y mismatch");
    
    var v2 = game.vec2(5.5, 7.5);
    assert(v2.x == 5.5, "vec2().x mismatch");
    assert(v2.y == 7.5, "vec2().y mismatch");
    
    print("  ✓ Vec2 construction works");
}

fn test_rect_construction() {
    print("=== TEST 2: Rect Construction ===");
    
    var r1 = game.Rect(100.0, 100.0, 200.0, 50.0);
    assert(r1.x == 100.0, "Rect.x mismatch");
    assert(r1.y == 100.0, "Rect.y mismatch");
    assert(r1.w == 200.0, "Rect.w mismatch");
    assert(r1.h == 50.0, "Rect.h mismatch");
    
    var r2 = game.rect(0.0, 0.0, 800.0, 600.0);
    assert(r2.x == 0.0, "rect().x mismatch");
    assert(r2.w == 800.0, "rect().w mismatch");
    
    print("  ✓ Rect construction works");
}

// ─────────────────────────────────────────────────────────────────────────────
// TEST 2: Collision Detection
// ─────────────────────────────────────────────────────────────────────────────

fn test_rect_contains() {
    print("=== TEST 3: Rect.contains() ===");
    
    var r = game.Rect(100.0, 100.0, 200.0, 50.0);
    
    // Points inside
    assert(r.contains(150.0, 120.0) == true, "Rect should contain center point");
    assert(r.contains(100.0, 100.0) == true, "Rect should contain top-left corner");
    assert(r.contains(299.0, 149.0) == true, "Rect should contain near bottom-right");
    
    // Points outside
    assert(r.contains(50.0, 50.0) == false, "Rect should not contain point above-left");
    assert(r.contains(350.0, 150.0) == false, "Rect should not contain point to right");
    assert(r.contains(150.0, 160.0) == false, "Rect should not contain point below");
    
    print("  ✓ Rect.contains() works correctly");
}

fn test_rect_intersects() {
    print("=== TEST 4: Rect.intersects() ===");
    
    var r1 = game.Rect(0.0, 0.0, 100.0, 100.0);
    var r2 = game.Rect(50.0, 50.0, 100.0, 100.0);
    var r3 = game.Rect(200.0, 200.0, 100.0, 100.0);
    
    // Overlapping rects
    assert(r1.intersects(r2) == true, "Overlapping rects should intersect");
    assert(r2.intersects(r1) == true, "Intersect should be symmetric");
    
    // Non-overlapping rects
    assert(r1.intersects(r3) == false, "Non-overlapping rects should not intersect");
    assert(r3.intersects(r1) == false, "Should be symmetric for non-overlapping");
    
    // Self intersection
    assert(r1.intersects(r1) == true, "Rect should intersect with itself");
    
    print("  ✓ Rect.intersects() works correctly");
}

// ─────────────────────────────────────────────────────────────────────────────
// TEST 3: Gameobject Hierarchy
// ─────────────────────────────────────────────────────────────────────────────

fn test_gameobject_construction() {
    print("=== TEST 5: GameObject Construction ===");
    
    var obj = game.GameObject(
        name="TestObject",
        id=1,
        active=true
    );
    
    assert(obj.name == "TestObject", "GameObject.name mismatch");
    assert(obj.id == 1, "GameObject.id mismatch");
    assert(obj.active == true, "GameObject.active should be true");
    
    print("  ✓ GameObject construction works");
}

fn test_gameobject_transform() {
    print("=== TEST 6: GameObject Transform ===");
    
    var obj = game.GameObject(name="Player", id=1);
    
    // Default transform
    assert(obj.transform.position.x == 0.0, "Default position.x should be 0");
    assert(obj.transform.position.y == 0.0, "Default position.y should be 0");
    assert(obj.transform.rotation == 0.0, "Default rotation should be 0");
    assert(obj.transform.scale == 1.0, "Default scale should be 1");
    
    // Modify transform
    obj.transform.position = game.Vec2(100.0, 200.0);
    assert(obj.transform.position.x == 100.0, "Position.x should be 100 after update");
    assert(obj.transform.position.y == 200.0, "Position.y should be 200 after update");
    
    obj.transform.rotation = 45.0;
    assert(obj.transform.rotation == 45.0, "Rotation should be 45 after update");
    
    print("  ✓ GameObject transform works");
}

// ─────────────────────────────────────────────────────────────────────────────
// TEST 4: Scene Management
// ─────────────────────────────────────────────────────────────────────────────

fn test_scene_instantiate() {
    print("=== TEST 7: Scene Instantiation ===");
    
    var scene = game.Scene();
    
    var obj1 = scene.instantiate("Enemy1");
    assert(obj1.name == "Enemy1", "Instantiated object should have correct name");
    assert(obj1.active == true, "Instantiated object should be active");
    assert(obj1.id >= 0, "Instantiated object should have valid ID");
    
    var obj2 = scene.instantiate("Enemy2");
    assert(obj2.name == "Enemy2", "Second object should have correct name");
    assert(obj2.id != obj1.id, "Each object should have unique ID");
    
    print("  ✓ Scene instantiation works");
}

fn test_scene_find() {
    print("=== TEST 8: Scene Find ===");
    
    var scene = game.Scene();
    
    var obj1 = scene.instantiate("Player");
    var obj2 = scene.instantiate("Enemy");
    
    var found_player = scene.find_by_name("Player");
    assert(found_player != nil, "Should find object by name");
    assert(found_player.name == "Player", "Found object should have correct name");
    
    var not_found = scene.find_by_name("NonExistent");
    assert(not_found == nil, "Should return nil for non-existent object");
    
    print("  ✓ Scene find works");
}

// ─────────────────────────────────────────────────────────────────────────────
// TEST 5: IMGUI Button Widget
// ─────────────────────────────────────────────────────────────────────────────

fn test_gui_button_basic() {
    print("=== TEST 9: GUI Button Basic ===");
    
    var gui = game.GUI();
    
    // Frame 1: Initialize
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(50.0, 50.0);
    
    var clicked1 = gui.button("Click Me", 100.0, 30.0);
    assert(clicked1 == false, "Button should not be clicked initially");
    
    gui.end();
    
    print("  ✓ GUI button basic works");
}

fn test_gui_button_hover() {
    print("=== TEST 10: GUI Button Hover ===");
    
    var gui = game.GUI();
    
    // Frame 1: Mouse over button
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(60.0, 60.0);  // Over button at 50,50 with size 100x30
    
    var hovered = gui.is_hovering(50.0, 50.0, 100.0, 30.0);
    assert(hovered == true, "Should detect hover");
    
    gui.end();
    
    // Frame 2: Mouse not over button
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(200.0, 200.0);  // Far from button
    
    var not_hovered = gui.is_hovering(50.0, 50.0, 100.0, 30.0);
    assert(not_hovered == false, "Should not detect hover when far");
    
    gui.end();
    
    print("  ✓ GUI button hover detection works");
}

fn test_gui_button_click() {
    print("=== TEST 11: GUI Button Click ===");
    
    var gui = game.GUI();
    
    // Frame 1: Mouse down on button
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(60.0, 60.0);
    gui.set_mouse_button(true);  // Mouse button down
    
    var clicked = gui.button("Click", 100.0, 30.0);
    assert(clicked == true, "Button should click when mouse over and pressed");
    
    gui.end();
    
    // Frame 2: Release mouse
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(60.0, 60.0);
    gui.set_mouse_button(false);  // Mouse button up
    
    var not_clicked = gui.button("Click", 100.0, 30.0);
    assert(not_clicked == false, "Button should not click when released");
    
    gui.end();
    
    print("  ✓ GUI button click detection works");
}

// ─────────────────────────────────────────────────────────────────────────────
// TEST 6: IMGUI Slider Widget
// ─────────────────────────────────────────────────────────────────────────────

fn test_gui_slider_basic() {
    print("=== TEST 12: GUI Slider Basic ===");
    
    var gui = game.GUI();
    
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(50.0, 100.0);
    
    var value = gui.slider("Volume", 0.5, 0.0, 1.0);
    assert(value >= 0.0 and value <= 1.0, "Slider value should be in range");
    assert(value == 0.5, "Slider should return initial value");
    
    gui.end();
    
    print("  ✓ GUI slider basic works");
}

fn test_gui_slider_drag() {
    print("=== TEST 13: GUI Slider Drag ===");
    
    var gui = game.GUI();
    
    // Frame 1: Start dragging
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(60.0, 100.0);  // Over slider knob
    gui.set_mouse_button(true);
    
    var value1 = gui.slider("Value", 0.5, 0.0, 1.0);
    
    gui.end();
    
    // Frame 2: Drag right
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(120.0, 100.0);  // Drag right
    gui.set_mouse_button(true);
    
    var value2 = gui.slider("Value", value1, 0.0, 1.0);
    assert(value2 > value1, "Slider value should increase when dragged right");
    
    gui.end();
    
    // Frame 3: Drag left
    gui.begin(800.0, 600.0, false);
    gui.set_cursor(30.0, 100.0);  // Drag left
    gui.set_mouse_button(true);
    
    var value3 = gui.slider("Value", value2, 0.0, 1.0);
    assert(value3 < value2, "Slider value should decrease when dragged left");
    
    gui.end();
    
    print("  ✓ GUI slider drag works");
}

